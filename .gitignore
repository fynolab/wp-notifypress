# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Ignore system created fils
.idea
.DS_Store

# Ignore build directories and tmp folders
# Source maps are emitted by dev-mode builds only; the shipped bundles are
# committed, their maps are not.
/assets/*-dist/*.map
/misc/tmp
/node_modules
/coverage
/vendor/bin/
/vendor/squizlabs/
/vendor/wp-coding-standards/
/vendor/phpcsstandards/
/vendor/dealerdirect/
phpcs-report.txt
.env
psysh_history

# Local-only credentials, never commit
docs/credentials.md

# Local development reference only
/screenshots
/CLAUDE.md
/UI_PARITY_REPORT.md
/docs
wp-banners/
/vendor/composer/installed.php
