<?xml version="1.0"?>
<ruleset name="NotifyPress">
	<description>WordPress PHP coding standards for NotifyPress.</description>

	<file>notifypress.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>assets/*-dist/*</exclude-pattern>

	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- src/ is PSR-4 autoloaded (Fynolab\NotifyPress\ => src/), so files
		     must be named after their class (e.g. App.php), not the
		     legacy WP "class-app.php" convention this sniff expects. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
</ruleset>
