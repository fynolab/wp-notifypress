{
    "name": "notifypress",
    "version": "1.0.0",
    "description": "A web push notification plugin for WordPress.",
    "main": "index.js",
    "packageManager": "pnpm@12.11.2",
    "scripts": {
        "app": "wp-scripts start assets/src/main.js --output-path=assets/main-dist",
        "app:build": "wp-scripts build assets/src/main.js --output-path=assets/main-dist",
        "editor:dev": "wp-scripts start assets/src/editor.js --output-path=assets/editor-dist",
        "editor:build": "wp-scripts build assets/src/editor.js --output-path=assets/editor-dist",
        "format": "wp-scripts format",
        "format:php": "composer phpcbf",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "lint:php": "composer phpcs",
        "typecheck": "tsc --noEmit",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "pnpm run version:check && composer install --no-dev && pnpm run build && wp-scripts plugin-zip && node bin/version.mjs rename-zip && composer install",
        "version:check": "node bin/version.mjs check",
        "version:bump": "node bin/version.mjs bump",
        "svn:deploy": "bash bin/svn-deploy.sh",
        "test:e2e": "wp-scripts test-e2e",
        "test:unit": "wp-scripts test-unit-js",
        "dev": "pnpm run app",
        "build": "pnpm run app:build && pnpm run editor:build"
    },
    "files": [
        "notifypress.php",
        "uninstall.php",
        "readme.txt",
        "src",
        "vendor",
        "assets/main-dist",
        "assets/editor-dist",
        "assets/images",
        "assets/service-worker.js",
        "assets/token-bridge.js",
        "assets/src",
        "composer.json",
        "composer.lock",
        "package.json",
        "pnpm-lock.yaml",
        "webpack.config.js",
        "tsconfig.json",
        "postcss.config.js",
        "tailwind.config.js"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/fynolab/notifypress"
    },
    "author": "Fynolab",
    "license": "GPL-2.0-or-later",
    "bugs": {
        "url": "https://github.com/fynolab/notifypress/issues"
    },
    "homepage": "https://github.com/fynolab/notifypress#readme",
    "dependencies": {
        "@radix-ui/react-alert-dialog": "^1.1.18",
        "@radix-ui/react-checkbox": "^1.3.7",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-popover": "^1.1.18",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.4.3",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.4.0",
        "@radix-ui/react-switch": "^1.3.2",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.12",
        "@tanstack/react-query": "^5.100.14",
        "@xyflow/react": "^12.11.1",
        "autoprefixer": "^10.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3-geo": "^3.1.1",
        "date-fns": "^3.6.0",
        "jquery": "^3.7.1",
        "lucide-react": "^0.477.0",
        "postcss": "^8.5.15",
        "react-content-loader": "^7.1.2",
        "react-day-picker": "^8.10.2",
        "react-loading-skeleton": "^3.5.0",
        "react-router-dom": "^6.30.3",
        "recharts": "^2.15.4",
        "sonner": "^1.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^3.4.19",
        "topojson-client": "^3.1.0",
        "world-atlas": "^2.0.2"
    },
    "devDependencies": {
        "@svgr/webpack": "^8.1.0",
        "@types/d3-geo": "^3.1.1",
        "@types/geojson": "^7946.0.16",
        "@types/jquery": "^3.5.34",
        "@types/node": "^20.19.43",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "@types/topojson-client": "^3.1.5",
        "@wordpress/scripts": "^30.27.0",
        "typescript": "^5.9.3",
        "url-loader": "^4.1.1"
    }
}
